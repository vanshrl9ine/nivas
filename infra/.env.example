# Copy to infra/.env to override the compose defaults.
#
#   cp infra/.env.example infra/.env
#
# Nothing here is required — every value has a default in docker-compose.yml.

# Elasticsearch image tag. Keep this within the same major version as the
# client (elasticsearch-java 9.x), or the client will refuse to talk to it.
ES_VERSION=9.1.0
